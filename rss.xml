---
layout: none
permalink: /rss.xml
# 네이버 서치어드바이저용 RSS 2.0 피드. Chirpy 기본 feed.xml은 Atom이라 네이버가 받지 않는다.
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/rss.xml" rel="self" type="application/rss+xml" />
    <description>{{ site.description | strip | xml_escape }}</description>
    <language>{{ site.lang | default: "ko-KR" }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll</generator>
    {%- for post in site.posts limit: 50 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <dc:creator>{{ site.social.name | xml_escape }}</dc:creator>
      {%- for category in post.categories %}
      <category>{{ category | xml_escape }}</category>
      {%- endfor %}
      <description>{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 400 | xml_escape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
